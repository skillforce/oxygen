---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHeroPoster } from '../data/heroMedia';
import GallerySection from '../components/GallerySection.astro';
import HeroSection from '../components/HeroSection.astro';
import HomeScripts from '../components/HomeScripts.astro';
import JoinSection from '../components/JoinSection.astro';
import ProgramsSection from '../components/ProgramsSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Ticker from '../components/Ticker.astro';

const title = 'Фитнес клуб OXYGEN FITNESS | Могилев';
const description = 'Фитнес клуб OXYGEN FITNESS | Могилев — клуб силовых и функциональных тренировок: настоящий коучинг, реальные люди, измеримый результат.';

const heroPoster = await getHeroPoster();
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={heroPoster.srcset}
      imagesizes={heroPoster.sizes}
      fetchpriority="high"
    />
  </Fragment>

  <SiteHeader />

  <main id="main">
    <HeroSection />
    <Ticker />
    <ProgramsSection />
    <GallerySection />
    <JoinSection />
  </main>

  <SiteFooter />
  <HomeScripts />
</BaseLayout>
