---
import { Image } from 'astro:assets';
import { galleryImages, site } from '../data/home';

const tileWidths = [400, 800];
const tileSizes = '(max-width: 640px) 50vw, (max-width: 900px) 33vw, (max-width: 1200px) 25vw, 20vw';

const tileShapes = [
  { className: 'tile-wide', weight: 0.75 },
  { className: 'tile-square', weight: 1 },
  { className: 'tile-tall', weight: 1.66 },
  { className: 'tile-portrait', weight: 1.25 },
  { className: 'tile-banner', weight: 0.8 },
  { className: 'tile-long', weight: 1.5 },
  { className: 'tile-base', weight: 1.33 },
];

const galleryTiles = galleryImages.map((image, index) => ({
  ...image,
  shape: tileShapes[index % tileShapes.length],
}));

type GalleryTile = (typeof galleryTiles)[number];


const GAP_WEIGHT = 0.07;

const columnHeight = (items: GalleryTile[]) =>
  items.reduce((sum, tile) => sum + tile.shape.weight, 0) + Math.max(items.length - 1, 0) * GAP_WEIGHT;

/**
 * Splits the tiles across two columns of near-equal height.
 *
 * Greedy longest-processing-time seed, then steepest-descent refinement over
 * single moves and pair swaps. Converges in ~2 passes and lands within ~0.03
 * column-widths (a few px) of the optimum, versus the previous exhaustive
 * subset search which was O(2^n) and overflowed `1 << n` past 31 tiles.
 */
const splitIntoBalancedColumns = (tiles: GalleryTile[]) => {
  const a: GalleryTile[] = [];
  const b: GalleryTile[] = [];
  const delta = () => Math.abs(columnHeight(a) - columnHeight(b));

  [...tiles]
    .sort((x, y) => y.shape.weight - x.shape.weight)
    .forEach((tile) => (columnHeight(a) <= columnHeight(b) ? a : b).push(tile));

  for (let pass = 0; pass < 100; pass += 1) {
    let improved = false;
    let best = delta();

    for (const [from, to] of [[a, b], [b, a]] as const) {
      for (let i = from.length - 1; i >= 0; i -= 1) {
        const [tile] = from.splice(i, 1);
        to.push(tile);
        if (delta() < best - 1e-9) {
          best = delta();
          improved = true;
        } else {
          to.pop();
          from.splice(i, 0, tile);
        }
      }
    }

    for (let i = 0; i < a.length; i += 1) {
      for (let j = 0; j < b.length; j += 1) {
        [a[i], b[j]] = [b[j], a[i]];
        if (delta() < best - 1e-9) {
          best = delta();
          improved = true;
        } else {
          [a[i], b[j]] = [b[j], a[i]];
        }
      }
    }

    if (!improved) break;
  }

  // Restore source order inside each column so the reading order stays stable.
  const sourceIndex = new Map(tiles.map((tile, index) => [tile, index]));
  const bySource = (x: GalleryTile, y: GalleryTile) => sourceIndex.get(x)! - sourceIndex.get(y)!;

  return [{ items: a.sort(bySource) }, { items: b.sort(bySource) }];
};

const mobileColumns = splitIntoBalancedColumns(galleryTiles);
---

<section class="gallery" id="gallery" aria-labelledby="gallery-h">
  <div class="wrap">
    <header class="gallery-head reveal">
      <h2 id="gallery-h">Наш <em>зал</em></h2>
      <div class="meta">
        <span class="eyebrow">02 — Зоны клуба</span>
        <b>{site.addressLine}</b>
      </div>
    </header>

    <div class="masonry">
      {
        galleryTiles.map((image) => (
          <figure class:list={['reveal', image.shape.className]}>
            <Image src={image.src} alt={image.alt} width={800} widths={tileWidths} sizes={tileSizes} format="avif" quality={43} loading="lazy" />
          </figure>
        ))
      }
    </div>

    <div class="mobile-masonry">
      {
        mobileColumns.map((column) => (
          <div class="mobile-masonry-column">
            {
              column.items.map((image) => (
                <figure class:list={['reveal', image.shape.className]}>
                  <Image src={image.src} alt={image.alt} width={800} widths={tileWidths} sizes={tileSizes} format="avif" quality={43} loading="lazy" />
                </figure>
              ))
            }
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery{
    background:var(--bg);
    padding:clamp(80px, 10vw, 140px) 0;
    border-top:1px solid var(--rule);
  }
  .gallery-head{
    display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;
    margin-bottom:clamp(40px, 6vw, 72px);
  }
  .gallery-head h2{
    font-family:var(--font-display);font-size:clamp(40px,6vw,92px);
    letter-spacing:-.03em;line-height:.9;text-transform:uppercase;color:var(--ink);
  }
  .gallery-head h2 em{color:var(--blue);font-style:normal}
  .gallery-head .meta{text-align:right}
  .gallery-head .meta .eyebrow{
    display:block;font-family:var(--font-mono);font-size:.78rem;font-weight:700;
    letter-spacing:.13em;text-transform:uppercase;color:var(--ink);margin-bottom:8px;
    text-shadow:0 1px 8px rgba(0,0,0,.6);
  }
  .gallery-head .meta .eyebrow::before{
    content:"";display:inline-block;width:7px;height:7px;margin-right:9px;
    border-radius:50%;background:var(--blue);box-shadow:0 0 10px rgba(79,165,216,.7);
    vertical-align:1px;
  }
  .gallery-head .meta b{color:var(--ink);font-weight:600;font-family:var(--font-body)}
  .masonry{
    column-count:5;
    column-gap:12px;
  }
  .mobile-masonry{display:none}
  .masonry figure,
  .mobile-masonry figure{
    margin:0 0 12px;
    break-inside:avoid;
    position:relative;border:1px solid rgba(79,165,216,.55);border-radius:14px;overflow:hidden;
    background:#191a1c;
    contain:layout paint style;
  }
  .masonry img,
  .mobile-masonry img{
    display:block;width:100%;height:100%;
    object-fit:cover;
  }
  .tile-wide{aspect-ratio:4/3}
  .tile-square{aspect-ratio:1/1}
  .tile-tall{aspect-ratio:3/5}
  .tile-portrait{aspect-ratio:4/5}
  .tile-banner{aspect-ratio:5/4}
  .tile-long{aspect-ratio:2/3}
  .tile-base{aspect-ratio:3/4}
  .masonry figure::after,
  .mobile-masonry figure::after{
    content:"";position:absolute;inset:0;
    box-shadow:inset 0 0 0 1px rgba(79,165,216,.35);border-radius:14px;pointer-events:none;
    transition:box-shadow .25s ease;
  }
  .masonry figure:hover::after,
  .mobile-masonry figure:hover::after{
    box-shadow:inset 0 0 0 2px rgba(79,165,216,.95), inset 0 0 22px rgba(79,165,216,.4);
  }
  .masonry figure:hover,
  .mobile-masonry figure:hover{border-color:rgba(79,165,216,1)}
  @media (max-width: 1200px){ .masonry{column-count:4} }
  @media (max-width: 900px){ .masonry{column-count:3} }
  @media (max-width: 640px){
    .masonry{display:none}
    .mobile-masonry{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:12px;
    }
    .mobile-masonry-column{
      display:flex;
      flex-direction:column;
      gap:12px;
      min-width:0;
    }
    .mobile-masonry figure{
      margin:0;
    }
  }
  @media (max-width: 560px){
    .gallery-head{grid-template-columns:1fr;align-items:start}
    .gallery-head .meta{text-align:left}
  }
</style>
