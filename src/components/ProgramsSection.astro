---
import { Image } from 'astro:assets';
import { programs } from '../data/home';

const cardWidths = [640, 1080, 1600];
const cardSizes = '(max-width: 980px) 100vw, 60vw';
---

<section class="programs" id="programs" aria-labelledby="programs-h">
  <div class="wrap">
    <header class="programs-head reveal">
      <h2 class="display" id="programs-h">Наши <em>преимущества</em></h2>
      <div class="meta">
        <span class="eyebrow">01 — Зоны и форматы</span>
        <b>Тренажёрный зал · кардио · тренеры</b>
      </div>
    </header>

    <div class="grid">
      {
        programs.map((program) => (
          <a href="#join" class:list={['card image reveal', program.className]}>
            <Image class="parallax-img" src={program.image} alt={program.alt} width={1600} widths={cardWidths} sizes={cardSizes} format="avif" quality={43} loading="lazy" />
            <span class="num">{program.number} / {program.label}</span>
            <h3>
              {program.title.before}<em>{program.title.emphasis}</em>{program.title.after}
            </h3>
            <p>{program.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .programs{
    background:var(--bg-2);
    padding:clamp(80px, 10vw, 140px) 0;
    border-top:1px solid var(--rule);
  }
  .programs-head{
    display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;
    margin-bottom:clamp(40px, 6vw, 72px);
  }
  .programs-head h2{
    font-size:clamp(44px, 8.5vw, 136px);
    color:var(--ink);
  }
  .programs-head h2 em{color:var(--blue);font-style:normal}
  .programs-head .meta{text-align:right;display:flex;flex-direction:column;gap:6px}
  .programs-head .eyebrow{
    font-size:.78rem;font-weight:700;letter-spacing:.13em;color:var(--ink);
    text-shadow:0 1px 8px rgba(0,0,0,.6);
  }
  .programs-head .eyebrow::before{
    content:"";display:inline-block;width:7px;height:7px;margin-right:9px;
    border-radius:50%;background:var(--blue);box-shadow:0 0 10px rgba(79,165,216,.7);
    vertical-align:1px;
  }
  .programs-head .meta b{color:var(--ink);font-weight:600;font-family:var(--font-body)}

  .grid{
    display:grid;
    grid-template-columns:repeat(12, 1fr);
    gap:16px;
  }
  .card{
    position:relative;background:var(--bg-card);
    border:1px solid var(--rule);
    border-radius:18px;overflow:hidden;
    min-height:340px;
    display:flex;flex-direction:column;justify-content:flex-end;
    padding:24px;
    transition:transform .5s cubic-bezier(.2,.7,.1,1), border-color .3s ease;
    isolation:isolate;
  }
  .card:hover{transform:translateY(-4px);border-color:rgba(79,165,216,.45)}
  .card:focus-visible{border-color:rgba(79,165,216,.75)}
  .card .num{
    position:absolute;z-index:2;top:18px;left:22px;
    padding:9px 13px;
    border:1px solid rgba(255,255,255,.3);border-radius:999px;
    font-family:var(--font-mono);font-size:.78rem;font-weight:700;
    line-height:1;letter-spacing:.1em;color:#fff;
    background:linear-gradient(135deg, rgba(47,134,191,.9), rgba(10,20,27,.88) 72%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.2), 0 5px 18px rgba(0,0,0,.36);
    text-shadow:0 1px 3px rgba(0,0,0,.75);
    backdrop-filter:blur(8px) saturate(140%);
    -webkit-backdrop-filter:blur(8px) saturate(140%);
  }
  .card h3{
    font-family:var(--font-display);font-size:clamp(28px, 3.2vw, 44px);
    letter-spacing:-.02em;line-height:.95;text-transform:uppercase;
    margin-bottom:.4em;color:var(--ink);
  }
  .card h3 em{color:var(--blue);font-style:normal}
  .card p{color:var(--ink-dim);max-width:36ch;font-size:.95rem}

  .card.image{
    background-color:#191a1c;
    min-height:520px;
    color:var(--ink);
  }
  /* Photo sits below the gradient (z-index -2 vs -1) so the darkening actually
     lands on top of it. Previously both were at -1, so the image painted over
     the gradient and the copy relied on text-shadow alone. */
  .card.image .parallax-img{
    position:absolute;inset:-10% 0 -10% 0;width:100%;height:120%;z-index:-2;
    object-fit:cover;
    transform:scale(1.06);
  }
  .card.image::before{
    content:"";position:absolute;inset:0;z-index:-1;
    background:linear-gradient(180deg, rgba(10,10,11,0) 20%, rgba(10,10,11,.55) 55%, rgba(10,10,11,.94) 100%);
  }
  .card.image h3,
  .card.image p{text-shadow:0 2px 14px rgba(0,0,0,.55)}
  .card.image p{color:#d7d8da}

  .c-1{grid-column:span 7}
  .c-2{grid-column:span 5}
  .c-3{grid-column:span 4}
  .c-4{grid-column:span 4}
  .c-5{grid-column:span 4}

  @media (max-width: 980px){
    .c-1,.c-2{grid-column:span 12}
    .c-3,.c-4,.c-5{grid-column:span 12}
  }
  @media (max-width: 820px){
    .programs-head{grid-template-columns:1fr;align-items:start}
    .programs-head .meta{text-align:left}
    .card{min-height:280px}
    .card.image{min-height:420px}
  }
</style>
