---
import PrimaryCta from './PrimaryCta.astro';
import { plans, priceGroups, site } from '../data/home';
---

<section class="join" id="join" aria-labelledby="join-h">
  <div class="join-bg" aria-hidden="true"></div>
  <div class="wrap">
    <header class="reveal">
      <span class="eyebrow">03 — Цены</span>
      <h2 class="display" id="join-h">Начни на <em>этой</em><br />неделе.</h2>
    </header>

    <div class="join-row reveal">
      <p>Приходи на ул. Чигринова 2А — посмотри зал, попробуй пару подходов. Останешься — оформим абонемент на месте.</p>
      <div class="join-cta">
        <PrimaryCta href={site.phoneHref}>Записаться</PrimaryCta>
      </div>
    </div>

    <div class="plans">
      {
        plans.map((plan) => (
          <article class:list={['plan reveal', { featured: plan.featured }]}>
            <span class="name">
              {plan.name}
              {plan.note ? ' ' : ''}
              {plan.note && <em>·</em>}
              {plan.note ? ` ${plan.note}` : ''}
            </span>
            <span class="price">{plan.price}<small>{plan.period}</small></span>
            <ul>
              {plan.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="price-table reveal">
      {
        priceGroups.map((group) => (
          <div class="price-group">
            <h3>
              <span class="title-lines">
                {group.title.split('\n').map((line) => <span>{line}</span>)}
              </span>
            </h3>
            {
              group.rows.map((row) => (
                <div class="price-row">
                  <span class="name">
                    {row.name}
                    {row.detail && <small>{row.detail}</small>}
                  </span>
                  <span class="val">{row.value} <em>{row.unit}</em></span>
                </div>
              ))
            }
          </div>
        ))
      }

      <p class="price-note">Все цены — в белорусских рублях, актуальны на момент публикации. Наличные и картой — на месте.</p>
    </div>
  </div>
</section>

<style>
  .join{
    position:relative;
    background:var(--bg-2);
    padding:clamp(80px, 10vw, 160px) 0 clamp(60px, 6vw, 100px);
    overflow:hidden;
  }
  .join-bg{
    position:absolute;inset:0;z-index:0;opacity:.35;
    background:
      radial-gradient(60% 60% at 80% 20%, rgba(79,165,216,.45), transparent 60%),
      radial-gradient(50% 50% at 10% 90%, rgba(79,165,216,.3), transparent 70%);
  }
  .join .wrap{position:relative;z-index:1}
  .join h2{
    font-size:clamp(56px, 12vw, 200px);
    color:var(--ink);
    line-height:1.05;
  }
  .join h2 em{color:var(--blue);font-style:normal}
  .join-row{
    display:grid;grid-template-columns:1.4fr 1fr;
    gap:clamp(24px, 5vw, 72px);align-items:end;justify-items:start;
    margin-top:clamp(32px, 5vw, 64px);
  }
  .join-cta{justify-self:end}
  .join-row p{font-size:clamp(16px, 1.4vw, 22px);max-width:44ch;color:var(--ink)}

  .plans{
    display:grid;grid-template-columns:repeat(4, minmax(0, 1fr));gap:14px;
    margin-top:clamp(48px, 6vw, 80px);
  }
  .plan{
    background:var(--bg-card);border:1px solid var(--rule);border-radius:18px;
    padding:24px 22px;display:flex;flex-direction:column;gap:14px;
    transition:transform .4s ease, border-color .3s ease;
  }
  .plan:hover{transform:translateY(-3px);border-color:rgba(79,165,216,.5)}
  .plan.featured{background:var(--blue);color:#0b0b0b;border-color:var(--blue)}
  .plan .name{font-family:'Archivo Black';text-transform:uppercase;font-size:1.05rem;letter-spacing:.04em}
  .plan .price{
    font-family:'Archivo Black';font-size:clamp(40px, 5vw, 64px);
    line-height:1;letter-spacing:-.02em;white-space:nowrap;
  }
  .plan .price small{font-size:.32em;font-family:'JetBrains Mono', monospace;letter-spacing:.1em;font-weight:400;display:inline-block;margin-left:6px;vertical-align:middle}
  .plan ul{list-style:none;display:flex;flex-direction:column;gap:8px;margin:8px 0}
  .plan ul li{font-size:.92rem;display:flex;gap:10px;align-items:flex-start}
  .plan ul li::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--blue);margin-top:.55em;flex:0 0 auto}
  .plan.featured ul li::before{background:#0b0b0b}

  .price-table{margin-top:clamp(48px, 6vw, 80px)}
  .price-group{margin-top:48px}
  .price-group:first-child{margin-top:0}
  .price-group h3{
    font-family:'JetBrains Mono', monospace;font-size:.78rem;
    letter-spacing:.2em;text-transform:uppercase;color:var(--ink-dim);
    margin-bottom:14px;font-weight:500;
    display:flex;align-items:center;gap:10px;
  }
  .price-group h3::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--blue)}
  .price-group h3 .title-lines{display:flex;flex-direction:column;gap:2px}
  .price-row{
    display:grid;grid-template-columns:1fr auto;gap:24px;
    padding:14px 0;border-top:1px solid var(--rule);
    align-items:baseline;
  }
  .price-row:last-child{border-bottom:1px solid var(--rule)}
  .price-row .name{font-size:clamp(15px,1.15vw,17px);color:var(--ink)}
  .price-row .name small{color:var(--ink-dim);font-family:'JetBrains Mono',monospace;font-size:.72rem;letter-spacing:.08em;margin-left:10px}
  .price-row .val{font-family:'Archivo Black';font-size:clamp(17px,1.6vw,22px);color:var(--ink);white-space:nowrap;letter-spacing:-.01em}
  .price-row .val em{color:var(--blue);font-style:normal;font-family:'JetBrains Mono',monospace;font-weight:400;font-size:.65em;letter-spacing:.08em;margin-left:4px}
  .price-note{margin-top:24px;color:var(--ink-dim);font-size:.85rem;max-width:60ch}

  @media (max-width: 1100px){
    .plans{grid-template-columns:repeat(2, minmax(0, 1fr))}
  }
  @media (max-width: 820px){
    .join-row{grid-template-columns:1fr}
    .plans{grid-template-columns:1fr}
  }
  @media (max-width: 400px){
    .join-cta{justify-self:start}
    .plan{padding:20px 18px}
    .price-row{grid-template-columns:1fr;gap:4px}
    .price-row .val{justify-self:start}
  }
</style>
