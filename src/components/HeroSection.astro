---
import ArrowRightIcon from './icons/ArrowRightIcon.astro';
import { hours, site } from '../data/home';
import { getHeroPoster } from '../data/heroMedia';
import heroVideoWebm from '../assets/videos/hero-video.webm';
import heroVideoMp4 from '../assets/videos/hero-video.mp4';

const heroPoster = await getHeroPoster();
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <img
      class="hero-poster"
      src={heroPoster.src}
      srcset={heroPoster.srcset}
      sizes={heroPoster.sizes}
      width={heroPoster.width}
      height={heroPoster.height}
      alt=""
      decoding="async"
      fetchpriority="high"
    />
    <video id="heroVideo" class="hero-video" muted loop playsinline preload="none">
      <source src={heroVideoWebm} type="video/webm" />
      <source src={heroVideoMp4} type="video/mp4" />
    </video>
  </div>

  <div class="hero-scan" aria-hidden="true"></div>
  <div class="hero-spot" aria-hidden="true"></div>

  <div class="hero-panel">
    <p class="hero-location">
      <span class="hero-location-dot" aria-hidden="true"></span>
      <span>Фитнес клуб</span>
      <span class="hero-location-sep" aria-hidden="true">·</span>
      <span class="hero-location-city">Могилев</span>
    </p>

    <div class="hero-branding">
      <p class="hero-kicker">Тренируйся. Становись сильнее.</p>

      <h1 class="hero-title display" id="hero-title">
        <span class="sr-only">Фитнес клуб </span>
        <span class="line"><span class="word">O<span class="x">X</span>YGEN</span></span>
        <span class="line"><span class="word">FITNESS</span></span>
        <span class="sr-only"> | Могилев</span>
      </h1>

      <p class="hero-subtitle">Интенсивные тренировки. Реальные результаты.</p>
    </div>


    <div class="hero-actions">
      <a class="hero-action hero-action-primary" href={site.phoneHref}>
        <span>Записаться на занятие</span>
        <span class="action-icon" aria-hidden="true"><ArrowRightIcon /></span>
      </a>
    </div>

    <table class="hours">
      <caption>Время работы</caption>
      <tbody>
        {
          hours.map((item) => (
            <tr>
              <th scope="row">{item.label}</th>
              <td><span>{item.from}</span><i>—</i><span>{item.to}</span></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

</section>

<style>
  .hero{
    position:relative;
    min-height:max(640px, 100svh);
    overflow:hidden;
    isolation:isolate;
    background:#080a0c;
  }
  .hero::before{
    content:"";
    position:absolute;
    inset:0;
    z-index:-1;
    pointer-events:none;
    background:
      linear-gradient(90deg, rgba(7,10,12,.99) 0%, rgba(7,10,12,.96) 27%, rgba(7,10,12,.78) 42%, rgba(7,10,12,.12) 67%, rgba(7,10,12,.18) 100%),
      linear-gradient(180deg, rgba(6,8,10,.38), transparent 45%, rgba(6,8,10,.48));
  }
  .hero::after{
    content:"";
    position:absolute;
    inset:0;
    z-index:-1;
    pointer-events:none;
    box-shadow:inset 0 0 140px rgba(0,0,0,.5);
  }
  .hero-media{
    position:absolute;
    inset:0;
    z-index:-2;
    background:#090b0d;
  }
  .hero-poster{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:calc(50% + 36px) 42%;
  }
  .hero-video{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    opacity:0;
    transition:opacity .9s ease;
    will-change:opacity;
    transform:translateX(36px) scale(1.06);
  }
  .hero-video.ready{opacity:1}

  .hero-panel{
    position:relative;
    z-index:2;
    width:min(43rem, 47vw);
    min-height:max(640px, 100svh);
    padding:clamp(112px, 15vh, 156px) 0 clamp(34px, 5vh, 58px) var(--pad);
    display:flex;
    flex-direction:column;
    align-items:flex-start;
  }
  .hero-location{
    display:inline-flex;
    align-items:center;
    gap:12px;
    margin:0 0 clamp(22px, 3.4vh, 40px) 10px;
    padding:11px 22px 11px 16px;
    border:1px solid rgba(236,236,234,.18);
    border-radius:999px;
    background:rgba(10,13,15,.45);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    color:rgba(236,236,234,.8);
    font-family:var(--font-mono);
    font-size:clamp(.76rem, .92vw, .96rem);
    font-weight:500;
    letter-spacing:.14em;
    line-height:1;
    text-transform:uppercase;
    box-shadow:inset 0 1px rgba(255,255,255,.06), 0 10px 30px rgba(0,0,0,.25);
    animation:heroFade .8s ease .25s both;
  }
  .hero-location-dot{
    width:8px;height:8px;flex:none;
    border-radius:50%;
    background:var(--blue);
    box-shadow:0 0 0 5px rgba(79,165,216,.18);
  }
  .hero-location-sep{color:var(--blue)}
  .hero-location-city{color:#f2f2ef}
  @keyframes heroFade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .sr-only{
    position:absolute;width:1px;height:1px;padding:0;margin:-1px;
    overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
  }
  .hero-branding{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
  }
  .hero-kicker{
    margin-bottom:clamp(18px, 2.8vh, 30px);
    color:var(--blue);
    font-family:var(--font-mono);
    font-size:clamp(.72rem, .88vw, .92rem);
    font-weight:500;
    letter-spacing:.15em;
    line-height:1.5;
    text-transform:uppercase;
    margin-left: 10px;
  }
  .hero-title{
    color:#f2f2ef;
    font-size:clamp(66px, 7.25vw, 124px);
    letter-spacing:-.045em;
    line-height:.84;
  }
  .hero-title .line{display:block;overflow:hidden;padding-right:.08em}
  .hero-title .word{
    display:inline-block;
    transform:translateY(108%);
    animation:heroRise .8s cubic-bezier(.2,.72,.1,1) forwards;
  }
  .hero-title .line:nth-child(2) .word{animation-delay:.1s}
  .hero-title .x{
    color:var(--blue);
  }
  @keyframes heroRise{to{transform:translateY(0)}}

  .hero-subtitle{
    margin-top:clamp(22px, 3.2vh, 34px);
    color:rgba(236,236,234,.76);
    font-family:var(--font-mono);
    font-size:clamp(.76rem, .9vw, .96rem);
    font-weight:500;
    letter-spacing:.075em;
    line-height:1.65;
    text-transform:uppercase;
    margin-left: 5px;
  }
  .hero-actions{
    display:flex;
    align-items:center;
    gap:clamp(18px, 2.2vw, 34px);
    margin-top:auto;
    margin-bottom:18px;
  }
  .hero-action{
    min-height:48px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:14px;
    white-space:nowrap;
    border-radius:999px;
    font-family:var(--font-mono);
    font-size:.72rem;
    font-weight:500;
    letter-spacing:.085em;
    text-transform:uppercase;
    transition:transform .2s ease, background-color .2s ease, color .2s ease;
  }
  .hero-action:hover,.hero-action:focus-visible{transform:translateY(-2px)}
  .hero-action:active{transform:translateY(0) scale(.98)}
  .hero-action-primary{
    min-height:46px;
    padding:6px 7px 6px 18px;
    color:#ececea;
    border:1px solid rgba(236,236,234,.3);
    background:rgba(10,13,15,.5);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    font-size:.66rem;
    letter-spacing:.075em;
    box-shadow:inset 0 1px rgba(255,255,255,.08), 0 14px 36px rgba(0,0,0,.28);
    margin-left: -5px;
  }
  .hero-action-primary:hover,.hero-action-primary:focus-visible{
    border-color:rgba(79,165,216,.8);
  }
  .action-icon{
    width:32px;
    height:32px;
    display:grid;
    place-items:center;
    border-radius:50%;
    color:#071016;
    background:var(--blue);
  }
  .action-icon :global(.icon){width:20px;height:20px}
  .hours{
    width:auto;
    margin-top:0;
    border-collapse:collapse;
    color:var(--ink);
    font-family:var(--font-mono);
  }
  .hours caption{
    padding-bottom:10px;
    color:var(--blue);
    font-size:.69rem;
    font-weight:500;
    letter-spacing:.16em;
    text-align:left;
    text-transform:uppercase;
  }
  .hours tr + tr{border-top:1px solid rgba(236,236,234,.1)}
  .hours th,.hours td{
    padding:7px 0;
    font-size:clamp(.68rem, .76vw, .78rem);
    font-weight:500;
    letter-spacing:.055em;
    text-transform:uppercase;
  }
  .hours th{padding-right:32px;color:rgba(236,236,234,.72);text-align:left}
  .hours td{display:flex;align-items:center;gap:9px;color:#ececea;font-variant-numeric:tabular-nums}
  .hours i{color:var(--blue);font-style:normal}

  .hero-scan{
    position:absolute;
    inset:0;
    z-index:0;
    pointer-events:none;
    background-image:repeating-linear-gradient(0deg, rgba(255,255,255,.016) 0 1px, transparent 1px 4px);
    opacity:.48;
  }
  .hero-spot{
    position:absolute;
    inset:0;
    z-index:0;
    pointer-events:none;
    background:radial-gradient(300px 300px at var(--mx,62%) var(--my,40%), rgba(79,165,216,.14), transparent 68%);
    mix-blend-mode:screen;
  }

  @media (max-width: 980px){
    .hero::before{
      background:
        linear-gradient(90deg, rgba(7,10,12,.98), rgba(7,10,12,.72) 72%, rgba(7,10,12,.38)),
        linear-gradient(180deg, rgba(7,10,12,.3), transparent 44%, rgba(7,10,12,.72));
    }
    .hero-panel{width:min(42rem, 68vw)}
  }

  @media (max-width: 720px){
    .hero{min-height:max(680px, 100svh)}
    .hero::before{
      background:linear-gradient(90deg, rgba(7,10,12,.96), rgba(7,10,12,.68)), linear-gradient(180deg, rgba(7,10,12,.2), transparent 38%, rgba(7,10,12,.9));
    }
    .hero-poster{object-position:58% center}
    .hero-video{object-position:58% center;transform:none}
    .hero-panel{
      width:100%;
      min-height:max(680px, 100svh);
      padding:104px var(--pad) 34px;
    }
    .hero-branding{
      position:absolute;
      top:50%;
      left:50%;
      display:block;
      width:max-content;
      max-width:calc(100% - (var(--pad) * 2));
      transform:translate(-50%, -50%);
    }
    .hero-title{
      position:static;
      width:max-content;
      max-width:100%;
      font-size:clamp(58px, 17.5vw, 92px);
      letter-spacing:.01em;
      text-align:left;
      transform:none;
    }
    .hero-title .word{white-space:nowrap}
    .hero-kicker{
      position:absolute;
      top:auto;
      right:auto;
      bottom:calc(100% + 5px);
      left:0;
      width:100%;
      margin:0;
      font-size:clamp(.54rem, 2.5vw, .63rem);
      letter-spacing:.08em;
      text-align:left;
      white-space:nowrap;
    }
    .hero-subtitle{
      position:absolute;
      top:calc(100% + 5px);
      right:auto;
      left:0;
      width:100%;
      margin:0;
      text-align:left;
    }
    .hero-location{margin-left:0}
    .hero-actions{margin-top:auto}
  }

  @media (max-width: 480px){
    .hero-actions{align-items:flex-start;flex-direction:column;gap:10px}
    .hero-action-primary{min-width:0}
    .hero-subtitle{font-size:.6rem}
    .hours th{padding-right:22px}
  }

  @media (prefers-reduced-motion: reduce){
    .hero-title .word{transform:none;animation:none}
    .hero-location{animation:none}
    .hero-action{transition:none}
  }
</style>
