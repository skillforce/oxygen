---
import { getImage } from 'astro:assets';
import PrimaryCta from './PrimaryCta.astro';
import { hours, site } from '../data/home';
import machinesBrick from '../assets/images/machines-brick.avif';

const heroPoster = await getImage({ src: machinesBrick, width: 1920, format: 'avif' });
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true" style={`--hero-poster:url('${heroPoster.src}');`}>
    <video id="heroVideo" class="hero-video" autoplay muted loop playsinline preload="metadata" poster={heroPoster.src}>
      <source src="/images/hero-video.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="hero-orbs" aria-hidden="true">
    <span class="o1"></span>
    <span class="o2"></span>
    <span class="o3"></span>
  </div>
  <div class="hero-scan" aria-hidden="true"></div>
  <div class="hero-spot" aria-hidden="true"></div>

  <h1 class="hero-title display" id="hero-title">
    <span class="line"><span class="word">O<span class="x">X</span>YGEN</span></span>
    <span class="line"><span class="word">FITNESS</span></span>
  </h1>

  <div class="hero-foot">
    <table class="hours">
      <caption class="eyebrow">Время работы</caption>
      <tbody>
        {
          hours.map((item) => (
            <tr>
              <th scope="row">{item.label}</th>
              <td>
                <span class="hh">{item.from}</span>
                <span class="dash">—</span>
                <span class="hh">{item.to}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="center"></div>
    <div class="right">
      <PrimaryCta href={site.phoneHref}>Записаться на занятие</PrimaryCta>
    </div>
  </div>

  <div class="hero-vitals" aria-hidden="true">
    <span class="vital"><span class="ind"></span><b>{site.addressLine}</b></span>
  </div>
</section>

<style>
  .hero{
    position:relative;
    min-height:100svh;
    overflow:hidden;
    display:flex;flex-direction:column;justify-content:flex-end;
    padding:0 var(--pad) clamp(24px, 5vw, 56px);
    isolation:isolate;
  }
  .hero-media{
    position:absolute;inset:0;z-index:-2;
    background:
      linear-gradient(180deg, rgba(20,21,23,.55) 0%, rgba(20,21,23,.25) 40%, rgba(20,21,23,.82) 100%),
      #0a0a0a var(--hero-poster) center 42%/cover no-repeat;
  }
  .hero-video{
    position:absolute;inset:0;width:100%;height:100%;
    object-fit:cover;object-position:center;
    z-index:-2;
    opacity:0;transition:opacity .9s ease;
    will-change:transform;
    filter:contrast(1.05) saturate(.85) brightness(.88) drop-shadow(0 20px 60px rgba(0,0,0,.5));
  }
  .hero-video.ready{opacity:.98}

  .hero-title{
    color:var(--ink);
    font-size:clamp(56px, 14.5vw, 240px);
    letter-spacing:-.035em;
    margin-bottom:.12em;
  }
  .hero-title .line{display:block;overflow:hidden}
  .hero-title .word{display:inline-block;transform:translateY(110%);animation:rise .9s cubic-bezier(.2,.7,.1,1) forwards}
  .hero-title .line:nth-child(2) .word{animation-delay:.12s}
  .hero-title .x{color:var(--blue);display:inline-block;transform-origin:50% 60%}
  @keyframes rise{to{transform:translateY(0)}}

  .hero-foot{
    display:grid;grid-template-columns:1fr auto 1fr;
    align-items:end;gap:24px;
    border-top:1px solid var(--rule);
    padding-top:18px;margin-top:18px;
  }
  .hero-foot .center{justify-self:center;text-align:center;color:var(--ink-dim)}
  .hero-foot .right{justify-self:end;text-align:right}

  .hours{
    border-collapse:collapse;
    width:max-content;max-width:100%;
    text-align:left;

  }
  .hours caption{
    text-align:left;
    padding-bottom:10px;
    color:var(--blue);
  }
  .hours tr{border-top:1px solid var(--rule)}
  .hours tr:last-child{border-bottom:1px solid var(--rule)}
  .hours th{
    font-family:'JetBrains Mono', monospace;
    font-weight:500;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;
    color:var(--ink);
    padding:11px 40px 11px 0;
    white-space:nowrap;
  }
  .hours td{
    font-family:'JetBrains Mono', monospace;
    padding:11px 0;
    color:var(--ink);
    display:flex;align-items:baseline;gap:10px;
  }
  .hours .hh{font-size:1.05rem;font-weight:500;font-variant-numeric:tabular-nums}
  .hours .dash{color:var(--blue);font-size:.9rem}

  .hero-orbs{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
  .hero-orbs span{position:absolute;border-radius:50%;filter:blur(40px);will-change:transform;contain:strict}
  .hero-orbs .o1{top:-12%;left:-10%;width:55vw;max-width:680px;aspect-ratio:1;
    background:radial-gradient(circle, rgba(79,165,216,.6), rgba(79,165,216,0) 65%);
    opacity:.55;animation:orbDrift1 32s ease-in-out infinite}
  .hero-orbs .o2{bottom:-16%;right:-12%;width:60vw;max-width:760px;aspect-ratio:1;
    background:radial-gradient(circle, rgba(79,165,216,.5), rgba(79,165,216,0) 70%);
    opacity:.4;animation:orbDrift2 46s ease-in-out infinite}
  .hero-orbs .o3{top:35%;left:55%;width:34vw;max-width:420px;aspect-ratio:1;
    background:radial-gradient(circle, rgba(255,255,255,.2), transparent 65%);
    opacity:.35;animation:orbDrift3 38s ease-in-out infinite}
  @keyframes orbDrift1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(8%,-6%) scale(1.1)}}
  @keyframes orbDrift2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-7%,6%) scale(.9)}}
  @keyframes orbDrift3{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-10%,-8%) scale(1.15)}}

  .hero-spot{
    position:absolute;inset:0;z-index:-1;pointer-events:none;
    background:radial-gradient(260px 260px at var(--mx,50%) var(--my,40%), rgba(79,165,216,.4), transparent 60%);
    mix-blend-mode:screen;
  }
  .hero-scan{
    position:absolute;inset:0;z-index:-1;pointer-events:none;
    background-image:repeating-linear-gradient(0deg, rgba(255,255,255,.025) 0 1px, transparent 1px 4px);
    animation:scanMove 12s linear infinite;opacity:.6;
  }
  @keyframes scanMove{from{background-position:0 0}to{background-position:0 80px}}

  .hero-vitals{
    position:absolute;left:var(--pad);bottom:14px;z-index:1;
    display:flex;flex-direction:column;gap:6px;pointer-events:none;
  }
  .hero-vitals .vital{
    font-family:'JetBrains Mono', monospace;font-size:.7rem;
    letter-spacing:.16em;text-transform:uppercase;color:var(--ink-dim);
    display:inline-flex;gap:8px;align-items:center;
  }
  .hero-vitals .vital b{color:var(--ink);font-weight:500}
  .hero-vitals .vital .ind{width:6px;height:6px;border-radius:50%;background:var(--blue);box-shadow:0 0 8px rgba(79,165,216,.7);animation:vitalPulse 2.2s ease-out infinite}
  @keyframes vitalPulse{
    0%{box-shadow:0 0 0 0 rgba(79,165,216,.55)}
    70%{box-shadow:0 0 0 10px rgba(79,165,216,0)}
    100%{box-shadow:0 0 0 0 rgba(79,165,216,0)}
  }

  @media (max-width: 820px){
    .hero{justify-content:flex-end;padding-bottom:80px}
    .hero-foot{grid-template-columns:1fr;text-align:left}
    .hero-foot .center,.hero-foot .right{justify-self:start;text-align:left}
    .hero-vitals{display:none}
  }
  @media (max-width: 480px){
    .hero-title{font-size:18vw}
    .hours th{padding-right:24px;font-size:.72rem}
    .hours .hh{font-size:.92rem}
  }
</style>
