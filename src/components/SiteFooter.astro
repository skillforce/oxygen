---
import Accreditation from './Accreditation.astro';
import Brand from './Brand.astro';
import { footerClubLinks, site } from '../data/home';
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <Brand />
        <p class="foot-summary">{site.summary}</p>
        <Accreditation number={site.accreditation} />
      </div>
      <div>
        <h4>Клуб</h4>
        <ul>
          {footerClubLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Адрес</h4>
        <ul>
          <li><address class="foot-address">{site.addressStreet}<br />{site.addressCity}</address></li>
          <li>Пн–Пт · 08:00–22:00<br />Сб–Вс · 09:00–18:00</li>
          <li><a href={site.instagramHref} target="_blank" rel="noopener noreferrer">{site.instagramLabel}</a></li>
        </ul>
      </div>
    </div>

    <p class="foot-big display">O<em>X</em>YGEN<br />FITNESS.</p>

    <div class="foot-bottom">
      <span>© 2026 Oxygen Fitness Club</span>
      <span class="mono">Республика Беларусь, г. Могилёв.</span>
    </div>
  </div>
</footer>

<style>
  .foot{
    background:var(--bg);
    padding:clamp(60px, 7vw, 100px) 0 32px;
    border-top:1px solid var(--rule);
  }
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px}
  .foot h4{font-family:var(--font-mono);font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-dim);margin-bottom:14px;font-weight:500}
  .foot ul{list-style:none;display:flex;flex-direction:column;gap:8px}
  .foot-summary{margin-top:14px;color:var(--ink-dim);max-width:34ch}
  .foot-address{font-style:normal}
  .foot ul a{color:var(--ink);transition:color .25s ease}
  .foot ul a:hover,.foot ul a:focus-visible{color:var(--blue)}
  .foot-big{
    font-family:var(--font-display);font-size:clamp(48px, 8vw, 120px);
    line-height:.9;letter-spacing:-.03em;text-transform:uppercase;
    margin:clamp(40px, 6vw, 72px) 0 24px;color:var(--ink);
  }
  .foot-big em{color:var(--blue);font-style:normal}
  .foot-bottom{
    display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;
    padding-top:24px;border-top:1px solid var(--rule);
    color:var(--ink-dim);font-size:.82rem;
  }
  @media (max-width: 820px){
    .foot-grid{grid-template-columns:1fr 1fr}
  }
  @media (max-width: 480px){
    .foot-grid{grid-template-columns:1fr}
  }
</style>
