---
export interface Props {
  number: string;
}

const { number } = Astro.props;
---

<span class="accred">Гос. аккредитация · <b>№ {number}</b></span>

<style>
  .accred{
    display:inline-flex;align-items:center;gap:10px;
    margin-top:18px;padding:8px 14px;
    border:1px solid var(--rule);border-radius:999px;
    font-family:'JetBrains Mono', monospace;font-size:.7rem;
    letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);
  }
  .accred::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--blue)}
  .accred b{color:var(--ink);font-weight:500}
</style>
