---
export interface Props {
  number: string;
}

const { number } = Astro.props;
---

<span class="accred">
  <span class="accred__label">Гос. аккредитация</span>
  <b class="accred__number">№&nbsp;{number}</b>
</span>

<style>
  .accred{
    display:inline-flex;align-items:center;gap:10px;
    max-width:100%;
    margin-top:18px;padding:8px 14px;
    border:1px solid var(--rule);border-radius:999px;
    font-family:var(--font-mono);font-size:.7rem;
    letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);
  }
  .accred::before{content:"";flex:none;width:6px;height:6px;border-radius:50%;background:var(--blue)}
  /* Both halves stay whole: the pill shrinks its tracking instead of
     breaking "№ 791285911" across lines. */
  .accred__label,.accred__number{white-space:nowrap}
  .accred__number{color:var(--ink);font-weight:500}

  @media (max-width: 560px){
    .accred{gap:8px;padding:8px 12px;font-size:.64rem;letter-spacing:.08em}
  }

  @media (max-width: 360px){
    .accred{gap:7px;padding:7px 11px;font-size:.6rem;letter-spacing:.05em}
  }
</style>
