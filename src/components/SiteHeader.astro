---
import Brand from './Brand.astro';
import { navLinks } from '../data/home';

export interface Props {
  /** Suppresses the tour link on the tour page itself. */
  hideTourLink?: boolean;
  /** Renders a back link pointing here — used by pages outside the one-pager. */
  backHref?: string;
}

const { hideTourLink = false, backHref } = Astro.props;
---

<header class="nav">
  <Brand />

  <nav class="nav-links" aria-label="Основная навигация">
    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <div class="nav-actions">
    {
      backHref && (
        <a href={backHref} class="nav-back" aria-label="Вернуться на главную">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 5l-7 7 7 7" />
          </svg>
          <span class="label-long">Назад</span>
        </a>
      )
    }

    {
      !hideTourLink && (
        <a href="/tour/" class="nav-tour" aria-label="Виртуальная экскурсия 360° по клубу">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3a9 9 0 1 0 9 9M12 3a9 9 0 0 1 9 9M12 3c-2.4 2.4-3.8 5.6-3.8 9s1.4 6.6 3.8 9c2.4-2.4 3.8-5.6 3.8-9S14.4 5.4 12 3ZM3.6 8h16.8M3.6 16h16.8" />
          </svg>
          <span class="label-long">Экскурсия 360°</span>
          <span class="label-short" aria-hidden="true">360°</span>
        </a>
      )
    }

    <a href="#join" class="nav-cta">
      <span class="dot" aria-hidden="true"></span>
      <span class="label-long">Пробное занятие</span>
    </a>
  </div>

</header>

<style>
  .nav{
    position:fixed;inset:0 0 auto 0;z-index:50;
    width:100%;
    max-width:100%;
    min-width:0;
    padding:18px var(--pad);
    display:flex;align-items:center;justify-content:space-between;
    gap:24px;
    --brand-size:18px;
    /* Solid rather than backdrop-filter: a blur on a position:fixed bar is
       re-sampled every scroll frame, and at this opacity over a near-black
       page it was not perceptible. */
    background:rgba(26,27,29,.92);
    border-bottom:1px solid var(--rule);
  }

  .nav-links{display:flex;gap:32px;align-items:center}
  .nav-links a{
    font-family:var(--font-mono);font-size:.78rem;
    text-transform:uppercase;letter-spacing:.14em;color:var(--ink-dim);
    position:relative;padding:6px 0;
  }
  .nav-links a:hover,.nav-links a:focus-visible{color:var(--ink)}
  .nav-links a::after{
    content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;
    background:var(--blue);transition:right .35s ease;
  }
  .nav-links a:hover::after,.nav-links a:focus-visible::after{right:0}

  .nav-actions{
    display:flex;align-items:center;gap:10px;
    min-width:0;flex-shrink:0;
  }

  .nav-back{
    display:inline-flex;align-items:center;gap:8px;
    white-space:nowrap;flex-shrink:0;
    padding:10px 16px;border:1px solid var(--rule);border-radius:999px;
    font-family:var(--font-mono);font-size:.74rem;
    text-transform:uppercase;letter-spacing:.14em;
    color:var(--ink-dim);
    transition:color .15s ease,border-color .15s ease;
  }
  .nav-back svg{
    width:15px;height:15px;flex:none;
    fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;
    transition:transform .15s ease;
  }
  .nav-back:hover,.nav-back:focus-visible{color:var(--ink);border-color:rgba(236,236,234,.34)}
  .nav-back:hover svg,.nav-back:focus-visible svg{transform:translateX(-2px)}

  .nav-tour{
    display:inline-flex;align-items:center;gap:8px;
    white-space:nowrap;flex-shrink:0;
    padding:10px 16px;border:1px solid var(--rule);border-radius:999px;
    font-family:var(--font-mono);font-size:.74rem;
    text-transform:uppercase;letter-spacing:.14em;
    color:var(--ink-dim);
    transition:color .15s ease,border-color .15s ease;
  }
  .nav-tour svg{
    width:15px;height:15px;flex:none;
    fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;
  }
  .nav-tour:hover,.nav-tour:focus-visible{color:var(--ink);border-color:rgba(236,236,234,.34)}
  .nav-tour .label-short{display:none}

  .nav-cta{
    position:relative;overflow:hidden;
    display:inline-flex;align-items:center;gap:10px;
    white-space:nowrap;
    flex-shrink:0;
    padding:10px 18px;border:1px solid rgba(236,236,234,.28);border-radius:999px;
    font-family:var(--font-mono);font-size:.74rem;
    text-transform:uppercase;letter-spacing:.14em;
    background:linear-gradient(155deg, rgba(255,255,255,.08), rgba(255,255,255,.015));
    backdrop-filter:blur(14px) saturate(160%);
    -webkit-backdrop-filter:blur(14px) saturate(160%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.18), inset 0 -1px 8px rgba(0,0,0,.1), 0 4px 16px rgba(0,0,0,.12);
    transition:transform .15s ease;
  }
  .nav-cta span{display:inline-block}
  .nav-cta:hover,.nav-cta:focus-visible{transform:scale(1.05)}
  .nav-cta .dot{width:6px;height:6px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 0 rgba(79,165,216,.7);animation:pulse 2.4s ease-out infinite}
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(79,165,216,.55)}
    70%{box-shadow:0 0 0 10px rgba(79,165,216,0)}
    100%{box-shadow:0 0 0 0 rgba(79,165,216,0)}
  }

  @media (max-width: 820px){
    .nav{
      position:absolute;
      gap:12px;
      padding:16px var(--pad);
      --brand-size:clamp(15px, 4.2vw, 18px);
    }
    .nav-links{display:none}
    .nav-actions{gap:8px}
    .nav-cta,.nav-tour,.nav-back{
      gap:8px;
      padding:9px 14px;
      font-size:clamp(.62rem, 2.35vw, .74rem);
      letter-spacing:.11em;
    }
  }

  /* Two pills plus the wordmark stop fitting well before 380px, so the tour
     link keeps only its globe and the degree sign. */
  @media (max-width: 560px){
    .nav-back{padding:9px 12px;letter-spacing:.06em}
    .nav-tour{padding:9px 11px;letter-spacing:.06em}
    .nav-tour .label-long{display:none}
    .nav-tour .label-short{display:inline}
  }

  @media (max-width: 380px){
    .nav{
      gap:8px;
      padding:14px var(--pad);
    }
    .nav-actions{gap:6px}
    .nav-cta{padding:8px 12px;font-size:.62rem;letter-spacing:.08em}
    .nav-cta .label-long{display:none}
    .nav-tour{padding:8px 10px;gap:5px;font-size:.62rem}
    .nav-back{padding:8px 10px;gap:5px;font-size:.62rem}
    .nav-back .label-long{display:none}
  }

  @media (max-width: 340px){
    .nav-tour{padding:8px 9px;letter-spacing:.04em}
  }
</style>
