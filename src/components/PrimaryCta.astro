---
import ArrowRightIcon from './icons/ArrowRightIcon.astro';

export interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} class="hero-cta">
  <slot />
  <span class="arrow" aria-hidden="true">
    <ArrowRightIcon />
  </span>
</a>

<style>
  .hero-cta{
    position:relative;overflow:hidden;
    display:inline-flex;align-items:center;gap:14px;
    padding:14px 22px 14px 26px;
    background:linear-gradient(155deg, rgba(20,21,23,.55), rgba(20,21,23,.28));
    backdrop-filter:blur(16px) saturate(180%);
    -webkit-backdrop-filter:blur(16px) saturate(180%);
    border:1px solid rgba(255,255,255,.3);
    color:#fff;
    border-radius:999px;font-family:'Archivo Black';
    font-size:.92rem;letter-spacing:.04em;text-transform:uppercase;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.3), inset 0 -12px 20px rgba(0,0,0,.15), 0 8px 24px rgba(0,0,0,.25);
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .hero-cta:hover,.hero-cta:focus-visible{transform:scale(1.05)}
  .hero-cta:active{transform:scale(.96);box-shadow:inset 0 1px 0 rgba(255,255,255,.25), inset 0 -6px 14px rgba(0,0,0,.2), 0 4px 12px rgba(0,0,0,.2)}
  .hero-cta > *{display:inline-block}
  .arrow{
    position:relative;
    width:28px;height:28px;border-radius:50%;background:var(--blue);color:#0b0b0b;
    display:grid;place-items:center;
    flex:0 0 auto;
    isolation:isolate;
  }
  .arrow::before{
    content:"";
    position:absolute;
    inset:0;
    border-radius:inherit;
    background:rgba(79,165,216,.35);
    z-index:-1;
    animation:arrowPulse 1.9s ease-out infinite;
  }
  @keyframes arrowPulse{
    0%{transform:scale(1);opacity:.75}
    70%{transform:scale(1.55);opacity:0}
    100%{transform:scale(1.55);opacity:0}
  }
</style>
