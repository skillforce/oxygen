<script is:inline>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wideViewport = window.matchMedia('(min-width: 721px)');

  // The hero video is preload="none" with no autoplay, so nothing is fetched
  // until we opt in here. Phones and reduced-motion users keep the poster only.
  const vid = document.getElementById('heroVideo');
  if (vid && wideViewport.matches && !reducedMotion.matches) {
    const revealVideo = () => vid.classList.add('ready');
    const setRate = () => { vid.playbackRate = 0.75; };
    vid.addEventListener('loadedmetadata', setRate);
    vid.addEventListener('loadeddata', revealVideo);
    vid.addEventListener('playing', revealVideo);
    vid.load();
    const started = vid.play();
    if (started) started.catch(() => {});
  }

  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-in'));
  }

  // Pointer spotlight. Measured once and refreshed on resize/scroll rather than
  // per event, and coalesced into one rAF, so a burst of pointermove events
  // cannot force a synchronous layout each time.
  const heroEl = document.querySelector('.hero');
  if (heroEl && finePointer.matches) {
    let rect = heroEl.getBoundingClientRect();
    let queued = false;
    let clientX = 0;
    let clientY = 0;

    const remeasure = () => { rect = heroEl.getBoundingClientRect(); };
    window.addEventListener('resize', remeasure, { passive: true });
    window.addEventListener('scroll', remeasure, { passive: true });

    heroEl.addEventListener('pointermove', (event) => {
      clientX = event.clientX;
      clientY = event.clientY;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        heroEl.style.setProperty('--mx', `${((clientX - rect.left) / rect.width) * 100}%`);
        heroEl.style.setProperty('--my', `${((clientY - rect.top) / rect.height) * 100}%`);
      });
    }, { passive: true });
  }
</script>

<style is:global>
  .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease, transform .8s cubic-bezier(.2,.7,.1,1)}
  .reveal.is-in{opacity:1;transform:translateY(0)}
</style>
