<script is:inline>
  const nav = document.getElementById('nav');
  nav?.classList.add('scrolled');

  const vid = document.getElementById('heroVideo');
  if (vid) {
    const revealVideo = () => vid.classList.add('ready');
    vid.addEventListener('loadeddata', revealVideo);
    vid.addEventListener('playing', revealVideo);
  }

  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-in'));
  }

  const heroEl = document.querySelector('.hero');
  if (heroEl) {
    heroEl.addEventListener('pointermove', (event) => {
      const rect = heroEl.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      heroEl.style.setProperty('--mx', `${x}%`);
      heroEl.style.setProperty('--my', `${y}%`);
    });
  }

  document.querySelectorAll('[data-parallax]').forEach((el) => {
    el.style.transform = 'scale(1.06)';
  });
</script>

<style is:global>
  .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease, transform .8s cubic-bezier(.2,.7,.1,1)}
  .reveal.is-in{opacity:1;transform:translateY(0)}
</style>
